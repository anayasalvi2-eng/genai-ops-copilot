# Environment variables for GenAI Ops Copilot Platform
# Copy this file to .env and fill in the values.
# NEVER commit your real .env file to source control.

# ── Provider chain ─────────────────────────────────────────────────────────────
# Ordered comma-separated list of providers to try (fallback left → right).
# Supported values: openai, ollama
LLM_PROVIDERS=openai,ollama

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Obtain your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Pin to a specific model version to prevent unexpected breaking changes.
# Use a dated suffix rather than a floating alias (e.g. gpt-4o-mini NOT gpt-4o).
OPENAI_MODEL=gpt-4o-mini-2024-07-18

# ── Ollama (local inference fallback) ─────────────────────────────────────────
# Install Ollama: https://ollama.com   |   Start: ollama serve
# Pull a model:   ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Governance & Budget ────────────────────────────────────────────────────────
# Hard daily USD spend cap across all providers.  Calls that would exceed this
# are rejected before the request is sent.
DAILY_BUDGET_USD=5.00
# Path for the append-only JSONL audit log.  Inputs/outputs are stored as
# SHA-256 hashes (never plaintext) for privacy compliance.
# AUDIT_LOG_PATH=./audit_log.jsonl   # defaults to backend/audit_log.jsonl
